.DS_Store
Thumbs.db
*.swp
*.swo

############################################
# RUST (Cargo, rustfmt, build artifacts)
############################################
# Generated by Cargo
debug/
target/

# Rustfmt backups
**/*.rs.bk

# Windows MSVC debug symbols
*.pdb

# Mutation testing output
**/mutants.out*/

# Rust backup files
*.old
*.last
*.backup
*.rs.bk

############################################
# PYTHON (build artifacts, caches, wheels)
############################################
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.python-version

# Virtual environments
.env
.venv
venv/

# Build outputs
build/
dist/
pip-wheel-metadata/

# Python extension modules (Rust → Python)
*.so
*.abi3.so

############################################
# CONDA
############################################
conda-meta/
pkgs/

############################################
