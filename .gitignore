############################################
*.o
*.obj
*.a
*.out
*.bin
*.hsaco
*.fatbin
*.hipfb
*.hiplog
*.hipinfo
*.linkinfo

############################################
# BUILD SCRIPTS & GENERATED CODE
############################################
build.rs.bk
/generated/
src.old/
src.20*/
*.generated.rs

